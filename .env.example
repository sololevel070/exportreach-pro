# ─────────────────────────────────────────────────────────────
# ExportReach — environment configuration
# Copy this file to .env and fill EVERY required value.
# The app validates required vars on boot and via GET /api/health.
# ─────────────────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────────────────

# Public URL the app is served from. MUST be publicly reachable so email
# open/click tracking pixels resolve (e.g. https://outreach.yourcompany.com).
NEXT_PUBLIC_APP_URL="https://outreach.example.com"

# Data store (InsForge project). Server-only — never expose these to the client.
INSFORGE_URL="https://YOUR-PROJECT.us-east.insforge.app"
INSFORGE_API_KEY="ik_your_project_admin_key"

# Session signing secret. Generate with:  openssl rand -hex 48
AUTH_SECRET="change-me-openssl-rand-hex-48"

# Shared secret protecting the /api/cron/* endpoints. Generate with:  openssl rand -hex 24
CRON_SECRET="change-me-openssl-rand-hex-24"

# Encryption key for secrets stored at rest (SMTP/AI keys). openssl rand -hex 32
# If unset, the app derives one from AUTH_SECRET (set this explicitly in production).
SECRETS_ENCRYPTION_KEY=""

# ── AI (at least one; used for generation/mapping) ───────────
GEMINI_API_KEY="your-gemini-api-key"
# Optional OpenAI-compatible fallback:
# OPENAI_API_KEY="sk-..."

# ── ACCESS CONTROL ───────────────────────────────────────────
# Allow public self-registration at /register. Set to "false" on a private,
# single-organization deployment and provision users manually.
ALLOW_REGISTRATION="true"

# ── EMAIL SENDING (configured per-user in Settings, these are fallbacks) ──
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER=""
# SMTP_PASS=""
# RESEND_API_KEY="re_..."
